# ──────────────────────────────────────────────
# Bright Smiles Dental — Environment Variables
# Copy to .env and fill in your credentials.
# ──────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Twilio (phone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Transfer target (front desk number)
TRANSFER_TARGET_NUMBER=

# Cal.com (booking backend)
CALCOM_API_KEY=
CALCOM_API_BASE=https://api.cal.com/v2
CALCOM_EVENT_TYPE_ID=
CALCOM_TIMEZONE=Australia/Brisbane

# Server
PUBLIC_BASE_URL=
PORT=7860

# DigitalOcean (deployment)
DIGITALOCEAN_API_KEY=
